# Content-Security-Policy for production builds, substituted into index.html by Vite.
# Development does not set it, because the dev server injects inline scripts.
VITE_CSP="default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; media-src 'self' blob: data:; worker-src 'self' blob:; connect-src 'self' data: blob: https://generativelanguage.googleapis.com https://r.jina.ai https://api.frankfurter.dev http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'self'"
