{
  "name": "spacelens",
  "private": true,
  "description": "SpaceLens: turn blueprints and rooms into a measured, explainable 3D model you can design in, walk through and check.",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "server": "node server/index.mjs",
    "test:server": "node --test \"server/test/*.mjs\"",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "docs:rules": "vite-node scripts/docs-rules.mjs rules",
    "docs:safety": "vite-node scripts/docs-rules.mjs safety",
    "eval:stoa": "node scripts/stoa-eval.mjs"
  },
  "dependencies": {
    "@react-three/drei": "9.114.0",
    "@react-three/fiber": "8.17.10",
    "pdfjs-dist": "4.7.76",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
