# Copy to .env.local for local development. Never commit real values.

# Optional: your own Gemini key. Calls then go straight to Google from the browser.
VITE_GEMINI_KEY=

# Optional: the SpaceLens API server (see server/README.md), e.g. http://localhost:8787.
# Used when no personal key is set. Leave empty to run on offline rules without a key.
VITE_API_BASE=

# ---- API server (server/index.mjs). Set these in the host's dashboard, not in the browser build.
# Required. The server's Gemini key; it never reaches the browser.
GEMINI_API_KEY=
# Comma-separated origins allowed to call the API. "http://localhost:*" allows any local port.
ALLOWED_ORIGINS=https://junction26.github.io,http://localhost:*
# Models the server may call, in order of preference.
MODEL_ALLOWLIST=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-4-hydrogen
# Per-client token bucket and the shared daily allowance of model calls.
RATE_LIMIT_BURST=20
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_DAILY=3000
# Largest accepted request body (images are sent inline as base64).
MAX_BODY_BYTES=8000000
# Read the client address from the platform proxy header (empty = socket address).
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=1
PORT=8787
